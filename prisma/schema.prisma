// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum INVOICESTATUS {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum USERROLE {
  SUPERADMIN
  ADMIN
  BILLING
}

enum TENANTSTATUS {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum IDEMPOTENCYSTATUS {
  PROCESSING
  DONE
  FAILED
}

enum APIKEYSTATUS {
  ACTIVE
  REVOKED
  EXPIRED
}

model Invoice {
  id         String        @id @default(cuid())
  amount     Int
  due_date   DateTime
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt
  customerId String
  status     INVOICESTATUS @default(DRAFT)
  customer   Customer      @relation(references: [id], fields: [customerId])
  payments   Payment[]
  tenant_id  String
  tenant     Tenant        @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, created_at])
  @@index([tenant_id, customerId, created_at])
}

model Tenant {
  id          String       @id @default(cuid())
  fullName    String
  email       String       @unique
  phoneNumber String
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  customers   Customer[]
  users       User[]
  status      TENANTSTATUS @default(ACTIVE)
  payments    Payment[]
  invoices    Invoice[]
  apiKeys     ApiKey[]
}

model Payment {
  id           String   @id @default(cuid())
  invoice_id   String
  invoice      Invoice  @relation(fields: [invoice_id], references: [id])
  customer_id  String
  customer     Customer @relation(fields: [customer_id], references: [id])
  payment_date DateTime @default(now())
  tenant_id    String
  tenant       Tenant   @relation(fields: [tenant_id], references: [id])
  created_at   DateTime @default(now())

  @@index([tenant_id, customer_id, created_at])
  @@index([tenant_id, invoice_id, created_at])
}

model Customer {
  id          String    @id @default(cuid())
  fullName    String
  email       String    @unique()
  phoneNumber String
  created_at  DateTime  @default(now())
  invoices    Invoice[]
  payments    Payment[]
  tenant_id   String
  tenant      Tenant    @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, email])
  @@index([tenant_id, created_at])
}

model User {
  id                    String    @id @default(cuid())
  fullName              String
  email                 String    @unique
  password              String
  phoneNumber           String
  role                  USERROLE  @default(BILLING)
  hashedRefreshToken    String?
  password_reset_token   String?
  password_reset_expires DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  is_enabled            Boolean   @default(true)
  tenant_id             String
  tenant                Tenant    @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, created_at])
  @@index([tenant_id, role, created_at])
}

model Idempotencykey {
  key         String            @id
  requestHash String
  ownerType   String?
  ownerId     String?
  status      IDEMPOTENCYSTATUS
  response    Json?
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt

  @@index([ownerId, ownerType])
}

model ApiKey {
  id           String       @id @default(cuid())
  name         String
  prefix       String
  keyHash      String       @unique
  tenant_id    String
  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  status       APIKEYSTATUS @default(ACTIVE)
  expires_at   DateTime?
  last_used_at DateTime?
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt

  @@index([tenant_id, status])
  @@index([keyHash])
}

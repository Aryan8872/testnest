<!DOCTYPE html>
<html lang="en">
<head>
  <style>
    body { font-family: 'Helvetica', Arial, sans-serif; color: #333; margin: 0; padding: 0; }
    .header { background-color: #0056b3; color: white; padding: 30px; text-align: center; }
    .logo { font-size: 28px; font-weight: bold; letter-spacing: 2px; }
    .content { padding: 40px; }
    h2 { color: #0056b3; margin-top: 0; }
    .details { margin-top: 20px; line-height: 1.8; font-size: 14px; }
    .details strong { width: 140px; display: inline-block; }
    .total-box { margin-top: 30px; padding: 20px; background-color: #f8f9fa; border-left: 5px solid #0056b3; }
    .total-box .total { font-size: 22px; font-weight: bold; color: #0056b3; margin: 0; }
    .payment-section { margin-top: 35px; padding: 20px; border: 1px dashed #0056b3; border-radius: 8px; display: flex; align-items: center; justify-content: space-between; background-color: #f0f7ff; }
    .payment-info { max-width: 60%; }
    .pay-btn { display: inline-block; background-color: #60bb46; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: bold; margin-top: 10px; }
    .khalti-btn { display: inline-block; background-color: #5d2e8e; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: bold; margin-top: 10px; margin-left: 8px; }
    .qr-box { text-align: center; }
    .qr-box img { width: 130px; height: 130px; border-radius: 4px; border: 1px solid #ddd; }
    .footer { margin-top: 45px; text-align: center; font-size: 12px; color: #888; border-top: 1px solid #eee; padding-top: 20px; }
  </style>
</head>
<body>
  <div class="header">
    <div class="logo">TAX INVOICE</div>
  </div>
  <div class="content">
    <h2>Hello {{customer.fullName}},</h2>
    <p>Thank you for your business. Here are your invoice details:</p>
    
    <div class="details">
      <p><strong>Invoice ID:</strong> {{id}}</p>
      <p><strong>Status:</strong> <span style="font-weight: bold; color: #0056b3;">{{status}}</span></p>
      <p><strong>Due Date:</strong> {{due_date}}</p>
      <p><strong>Customer Email:</strong> {{customer.email}}</p>
    </div>

    <div class="total-box">
      <p class="total">Total Amount: NPR {{amountRupees}}</p>
    </div>

    {{#if paymentQrCode}}
    <div class="payment-section">
      <div class="payment-info">
        <h3 style="color: #0056b3; margin: 0 0 10px 0;">Instant Online Payment</h3>
        <p style="font-size: 13px; color: #555; margin: 0 0 15px 0;">
          Scan the QR code with your mobile camera or click below to pay securely via eSewa / Khalti.
        </p>
        <a href="{{paymentUrl}}" class="pay-btn">Pay with eSewa / Khalti</a>
      </div>
      <div class="qr-box">
        <img src="{{paymentQrCode}}" alt="Payment QR Code" />
        <div style="font-size: 11px; color: #666; margin-top: 4px;">Scan to Pay</div>
      </div>
    </div>
    {{/if}}
    
    <div class="footer">
      <p>If you have any questions regarding this invoice, please contact our support team.</p>
    </div>
  </div>
</body>
</html>
